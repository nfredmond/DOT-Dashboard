# MapTiler API key - Get yours at https://www.maptiler.com/cloud/
NEXT_PUBLIC_MAPTILER_ACCESS_TOKEN=your_maptiler_api_key_here

# Mapbox API key - Get yours at https://www.mapbox.com/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_api_key_here

# OpenAI API key - Get yours at https://platform.openai.com/
# Required for OpenAI services including Whisper speech-to-text and GPT-4 Vision
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration - Required for authentication and database
# Get your credentials from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Sesame CSM Configuration (optional) - Released March 2025
# Path to the Sesame CSM repository (git clone https://github.com/SesameAILabs/csm.git)
SESAME_CSM_PATH=/path/to/sesame/csm
# Directory for downloaded models
SESAME_MODELS_DIR=/path/to/models
# HuggingFace repo for CSM model
SESAME_CSM_MODEL_PATH=sesame/csm-1b
# HuggingFace repo for Llama model
SESAME_LLAMA_MODEL_PATH=sesame/llama-3.2-1b

# Other environment variables
# ... 

# Offline database enabled
OFFLINE_DATABASE_ENABLED=false 