# Production environment configuration
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_ENABLE_MOCK_DATA=false

# Domain configuration
NEXT_PUBLIC_APP_DOMAIN=planningmanager.ai
NEXT_PUBLIC_APP_URL=https://planningmanager.ai

# Supabase Configuration
# Replace with your actual production Supabase URL and key
NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key

# Optional: API keys for mapping services
# NEXT_PUBLIC_MAPTILER_ACCESS_TOKEN=your_maptiler_api_key
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_api_key

# Optional: OpenAI API key for AI features
# OPENAI_API_KEY=your_openai_api_key 