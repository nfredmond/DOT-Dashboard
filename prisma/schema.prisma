// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts                Account[]
  sessions                Session[]
  projects                Project[]             @relation("CreatedByUser")
  updatedProjects         Project[]             @relation("UpdatedByUser")
  projectScenarios        ProjectScenario[]     @relation("CreatedByUser")
  scenarioComparisons     ScenarioComparison[]  @relation("CreatedByUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  location    String?
  status      String?
  category    String?
  priority    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  startDate   String?
  endDate     String?
  geoJson     Json?

  // Add fields for analysis results
  scoreData        Json?
  analysisResults  Json?

  // Relations
  createdBy         User?                @relation("CreatedByUser", fields: [createdById], references: [id])
  updatedBy         User?                @relation("UpdatedByUser", fields: [updatedById], references: [id])
  scenarios         ProjectScenario[]
  scenarioComparisons ScenarioComparison[]
}

model ProjectScenario {
  id               String    @id @default(cuid())
  projectId        String
  name             String
  description      String    @db.Text
  timeline         String
  cost             Float
  benefits         String[]
  drawbacks        String[]
  feasibility      Float
  impact           Json?
  analysis         String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?
  parentScenarioId String?

  // Relations
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy        User?     @relation("CreatedByUser", fields: [createdById], references: [id])
  parentScenario   ProjectScenario? @relation("ScenarioRefinements", fields: [parentScenarioId], references: [id])
  refinements      ProjectScenario[] @relation("ScenarioRefinements")
  scenarioComparisons1 ScenarioComparison[] @relation("Scenario1")
  scenarioComparisons2 ScenarioComparison[] @relation("Scenario2")
}

model ScenarioComparison {
  id              String   @id @default(cuid())
  projectId       String
  scenario1Id     String
  scenario2Id     String
  comparison      String   @db.Text
  recommendation  String?  @db.Text
  scores          Json?
  createdAt       DateTime @default(now())
  createdById     String?

  // Relations
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenario1       ProjectScenario @relation("Scenario1", fields: [scenario1Id], references: [id], onDelete: Cascade)
  scenario2       ProjectScenario @relation("Scenario2", fields: [scenario2Id], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("CreatedByUser", fields: [createdById], references: [id])
} 