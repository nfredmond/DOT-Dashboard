{
  "name": "planning-manager",
  "version": "0.1.0",
  "description": "Planning Manager with Mapbox GL JS integration",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--max_old_space_size=4096 --trace-warnings\" next dev --turbopack -p 3005",
    "custom-dev": "cross-env NODE_OPTIONS=\"--max_old_space_size=4096 --trace-warnings\" node custom-server.js",
    "clean-dev": "npx rimraf .next && cross-env NODE_OPTIONS=\"--max_old_space_size=4096 --trace-warnings\" next dev -p 3005",
    "safe-dev": "cross-env NODE_OPTIONS=\"--max_old_space_size=4096 --trace-warnings\" WATCHPACK_POLLING=true next dev -p 3005",
    "start-dev": "cross-env NODE_OPTIONS=\"--max_old_space_size=4096 --trace-warnings\" SKIP_TYPESCRIPT_CHECK=true next dev -p 3005",
    "dev-simple": "cross-env NODE_OPTIONS=\"--max_old_space_size=4096\" node development-app.js",
    "build": "cross-env NODE_OPTIONS=\"--max_old_space_size=4096\" next build",
    "safe-build": "cross-env NODE_OPTIONS=\"--max_old_space_size=4096\" SKIP_TYPESCRIPT_CHECK=true next build",
    "start": "cross-env next start",
    "lint": "cross-env next lint",
    "lint:strict": "cross-env eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings=0",
    "lint:fix": "cross-env eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "fix-types": "powershell -Command \"if(Test-Path .next\\types) { try { Remove-Item .next\\types -Recurse -Force -ErrorAction SilentlyContinue } catch { Write-Host 'Could not remove directory, continuing...' } }; New-Item -ItemType Directory -Force -Path .next\\types | Out-Null; Set-Content -Path .next\\types\\package.json -Value '{\\\"name\\\":\\\"next-types\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"description\\\":\\\"Next.js types\\\",\\\"type\\\":\\\"module\\\",\\\"private\\\":true}'\"",
    "fix-types:bash": "bash -c \"rm -rf .next/types && mkdir -p .next/types && echo '{\\\"name\\\":\\\"next-types\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"description\\\":\\\"Next.js types\\\",\\\"type\\\":\\\"module\\\",\\\"private\\\":true}' > .next/types/package.json\""
  },
