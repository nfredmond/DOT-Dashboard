# Planning Manager v10 Environment Configuration
# Copy this file to .env.local and fill in the values

# ===================================
# REQUIRED: Database Configuration
# ===================================
# Option 1: Supabase (Cloud Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Option 2: Offline Database (No external database needed)
# Set this to true to use IndexedDB instead of Supabase
OFFLINE_DATABASE_ENABLED=false

# ===================================
# REQUIRED: Mapping Services
# ===================================
# Get your token from: https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-access-token
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# Alternative mapping provider (optional)
NEXT_PUBLIC_MAPTILER_ACCESS_TOKEN=

# ===================================
# REQUIRED: Authentication
# ===================================
# Generate a secret key for authentication
# You can use: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-key-here

# ===================================
# REQUIRED: AI Services (at least one)
# ===================================
# OpenAI API Key - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API Key - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Groq API Key (optional) - https://console.groq.com/
GROQ_API_KEY=

# Meta AI API Key (optional)
META_AI_API_KEY=

# ===================================
# OPTIONAL: External Data Services
# ===================================
# US Census API - https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
CENSUS_API_BASE_URL=https://api.census.gov/data

# California SWITRS Traffic Data
SWITRS_API_KEY=

# ESRI/ArcGIS Services
ESRI_API_KEY=

# ===================================
# OPTIONAL: Advanced Features
# ===================================
# Model Component Package (MCP) Support
MCP_ENABLED=false

# Voice Interface Features
ENABLE_VOICE=true

# Sesame Local LLM Support (experimental)
SESAME_CSM_PATH=
SESAME_MODELS_DIR=./models/sesame
SESAME_LLAMA_MODEL_PATH=sesame/llama-3.2-1b
SESAME_CSM_MODEL_PATH=sesame/csm-1b

# ===================================
# APPLICATION CONFIGURATION
# ===================================
# Application Environment
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_DOMAIN=localhost:3005
NEXT_PUBLIC_APP_URL=http://localhost:3005

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3005/api

# Development Tools
NEXT_PUBLIC_ENABLE_MOCK_DATA=false
DEBUG=false

# ===================================
# DEPLOYMENT CONFIGURATION
# ===================================
# Node Environment
NODE_ENV=development
NODE_OPTIONS="--max_old_space_size=4096"

# Next.js Configuration
SKIP_TYPESCRIPT_CHECK=false
WATCHPACK_POLLING=false

# ===================================
# PRODUCTION DEPLOYMENT
# ===================================
# When deploying to production, update these:
# NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_APP_DOMAIN=planningmanager.ai
# NEXT_PUBLIC_APP_URL=https://planningmanager.ai
# NODE_ENV=production 